# Copy to .env and fill in, then: docker compose up  (or python agent.py)

# FiremeX cloud control plane the agent reports to.
FIREMEX_CLOUD_URL=https://app.firemex.io

# Site enrollment token from FiremeX → Sites → Create Site (shown once).
AGENT_TOKEN=

# Seconds between heartbeats.
HEARTBEAT_INTERVAL=10

# "yolo" = real detection (needs the model below); "mock" = no ML (setup/tests).
DETECTOR_MODE=yolo
MODEL_PATH=models/fire_model.pt
