# Environment for the production Compose overlay. Copy to .env.production and
# fill in, then:
#
#   set -a && . ./.env.production && set +a
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# These values are read by docker-compose.prod.yml and the Caddyfile.
# Application secrets (JWT, Stripe, Twilio, SMTP) live in backend/.env — see
# backend/.env.example.

# Public hostname. Its DNS A/AAAA record must already point at this server, or
# Let's Encrypt cannot issue a certificate.
FIREMEX_DOMAIN=firemex.example.com

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=ops@example.com

# MongoDB credentials. Generate the password, don't invent one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MONGO_USER=firemax
MONGO_PASSWORD=
