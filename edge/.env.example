# Copy to edge.env next to docker-compose.yml, fill in AGENT_TOKEN, then:
#   docker compose up -d

# ── Cloud connection ────────────────────────────────────────────────────────
# The FiremeX control plane this agent reports to. The agent sends detections
# and site credentials over it, so it must be https:// anywhere real.
FIREMEX_CLOUD_URL=https://backend-production-0c43.up.railway.app

# Site enrollment token: FiremeX → Sites → Create Site. Shown ONCE at creation;
# if you lose it, use "Rotate token" on that site and re-paste the new value.
# Rotating immediately invalidates the previous token, so any agent still using
# it starts getting 401s until updated.
AGENT_TOKEN=

# Seconds between heartbeats. The site shows as Online in the app while these
# keep arriving.
HEARTBEAT_INTERVAL=10

# ── Detection ───────────────────────────────────────────────────────────────
# "yolo" = real detection (needs the weights below).
# "mock" = no ML at all — use this while first wiring up a site, or on
#          low-power hardware during setup. It never reports a hazard.
DETECTOR_MODE=yolo

# Where the weights live on this box. With the Compose file here, this path is
# a named volume, so the download is cached across restarts.
MODEL_PATH=/app/models/fire_model.pt

# If the file above is missing, the agent downloads it from here on first run.
# MODEL_SHA256 pins the exact file: a wrong or tampered model is a SILENT
# detection failure, which in this product means a fire nobody is told about.
# The agent refuses to start on a mismatch rather than run blind.
MODEL_URL=https://github.com/malika1234m/Firemax/releases/download/v0.1.0/fire_model.pt
MODEL_SHA256=2ab009042ba04827ee1cd1ccb0648832577677334c5fe4927e7c7950f7406c89

# ── Local webcam testing (optional) ─────────────────────────────────────────
# Feed one registered camera from this machine's webcam instead of its RTSP
# URL. Note this rarely works from inside Docker on macOS/Windows — there is no
# host camera passthrough. Prefer giving the camera an http(s) video URL as its
# stream_url, which OpenCV opens directly and needs no hardware at all.
# WEBCAM_CAMERA_ID=
# WEBCAM_DEVICE=0
