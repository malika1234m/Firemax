# Copy to .env and fill in. NEVER commit the real .env (see ../.gitignore).

# "development" or "production". In production the server REFUSES to start if
# JWT_SECRET is still the placeholder, COOKIE_SECURE is false,
# SECRETS_ENCRYPTION_KEY is unset, FRONTEND_URL is http://, or CORS_ORIGINS
# still points at localhost. docker-compose.prod.yml sets this for you.
ENVIRONMENT=development

MONGODB_URL=mongodb://localhost:27017
DB_NAME=firemax

# Path to your YOLOv8 fire model (.pt file)
# Get one from: https://universe.roboflow.com (search "fire smoke detection")
MODEL_PATH=models/fire_model.pt
CONFIDENCE_THRESHOLD=0.5
PROCESS_FPS=5

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate a strong random value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every existing login session.
JWT_SECRET=change-me-generate-a-random-48-byte-secret
JWT_EXPIRE_HOURS=24
# Set to true once served over HTTPS so the session cookie is HTTPS-only.
COOKIE_SECURE=false

# Encrypts per-org secrets (Home Assistant tokens) at rest. REQUIRED to store
# HA credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=

# Internal FiremeX platform ops console (vendor-only, cross-tenant monitoring).
# If both are set, this super-admin is created on startup. Keep OFF the customer
# surface — ideally serve /platform on a separate subdomain in production.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# ── Rate limiting ────────────────────────────────────────────────────────────
# Shared store for rate limits — REQUIRED once you run more than one instance /
# behind a load balancer. Blank = process-local limiter (single-instance dev).
REDIS_URL=
# Number of reverse proxies in front of the app. The client IP is read that
# many hops from the right of X-Forwarded-For. 0 = trust none (use socket peer).
# NEVER exceed your real proxy depth or clients can spoof their IP.
TRUSTED_PROXY_COUNT=0

# ── Home Assistant integration ───────────────────────────────────────────────
# HA is now configured PER ORGANIZATION from the app's Settings → Home
# Assistant page (each customer runs their own HA). Only the webhook label is
# global; URL + token live encrypted on each organization.
HA_WEBHOOK_ID=firemax_hazard_alert

# ── Email alerts + demo-request notifications (optional) ─────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=
# Where "Request a Demo" submissions are emailed (falls back to ALERT_EMAIL).
SALES_EMAIL=

# ── Twilio (authority call/SMS on confirmed incidents, optional) ─────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Stripe billing (optional — blank disables billing gracefully) ────────────
# Test-mode keys from dashboard.stripe.com/test/apikeys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173
